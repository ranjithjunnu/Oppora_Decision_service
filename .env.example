# Backend only. Copy desired settings into .env; never put API keys in frontend files.

# -----------------------------------------------------------------------------
# 1. LLM Provider (Choose one: 'deepseek', 'groq', or 'openai_compatible')
# -----------------------------------------------------------------------------
# If LLM_PROVIDER is blank, DeepSeek is used whenever DEEPSEEK_API_KEY is set
# (Oppora scores leads with DeepSeek); otherwise Groq.
LLM_PROVIDER=

# --- Provider API Keys ---
# Groq API key:
GROQ_API_KEY=

# DeepSeek API key, model and base URL. LLM_MODEL / LLM_BASE_URL override these when set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Generic OpenAI-compatible API key (when using LLM_PROVIDER=openai_compatible):
LLM_API_KEY=

# --- Model & Generation Parameters ---
# Optional override for any provider. Groq default: openai/gpt-oss-120b.
LLM_MODEL=

# Format: json_schema (Groq default) or json_object (DeepSeek default). Leave blank for the provider default.
LLM_RESPONSE_FORMAT=
LLM_TIMEOUT_SECONDS=60
# Leave blank for 2048 (8192 when LLM_THINKING=enabled).
LLM_MAX_OUTPUT_TOKENS=
# DeepSeek flash reasons before answering unless disabled. Hidden reasoning tokens count as output.
# enabled (default for DeepSeek; matches Oppora's ~137 output tokens per scoring call) | disabled | provider_default
LLM_THINKING=enabled

# Custom base URL for openai_compatible (DeepSeek uses DEEPSEEK_BASE_URL)
# LLM_BASE_URL=

# Oppora-style batching: one call per company, split into batches of this size,
# with this many batches in flight at once.
LEAD_SCORING_BATCH_SIZE=100
LEAD_SCORING_CONCURRENCY=4
# oppora-filter-v2 = Oppora's observed prompt format (default); oppora-filter-v1 = our earlier adaptation.
LEAD_SCORING_PROMPT=oppora-filter-v2

# People directory inside datasets/. company_directory.json = 55,000 synthetic people;
# oppora_live_sample.json = 200 real, labelled people from Oppora. Restart the backend after changing.
DIRECTORY_FILE=company_directory.json

# -----------------------------------------------------------------------------
# 2. TypeSafe JEV (called only when a lead-scoring run sets decision_model to "jev")
# -----------------------------------------------------------------------------
JEV_API_KEY=
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# Pinned version (jev-latest moves). jev-1.14.0 is the newer preview.
JEV_MODEL=jev-1.13.0
# A lead is selected only when every requirement Jev checks has at least this probability.
JEV_MATCH_THRESHOLD=0.5
JEV_CONCURRENCY=8
JEV_TIMEOUT_SECONDS=30
# Published price; output tokens are free.
JEV_INPUT_COST_PER_MILLION=0.042

# -----------------------------------------------------------------------------
# 3. Decision Lab & Task Settings
# -----------------------------------------------------------------------------
# Decision Lab uses the configured LLM only; no local model is required.
ENABLE_DECISION_LAB=true

# Historical Decision Lab task; unused by the active scoring application.
# Set to custom to require an explicit criterion with each API request instead.
EVALUATION_TASK=gtm_intent

# -----------------------------------------------------------------------------
# 4. Optional Token Cost Estimation (Leave blank if not configured)
# -----------------------------------------------------------------------------
LLM_INPUT_COST_PER_MILLION=
LLM_CACHED_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=


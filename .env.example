# Backend only. Copy desired settings into .env; never put API keys in frontend files.
LLM_PROVIDER=groq
GROQ_API_KEY=

# Model used for AI Lead Scoring and optional ICP drafting. No local model is required.
LLM_MODEL=openai/gpt-oss-120b
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048

# Decision Lab is optional and imports the local Laya runtime only when enabled.
# Set ENABLE_DECISION_LAB=true in the process environment before starting uvicorn.
# Historical Decision Lab task; unused by the active scoring application.
# Set to custom to require an explicit criterion with each API request instead.
EVALUATION_TASK=gtm_intent

# Optional estimates. Blank means cost is unavailable, NOT zero.
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=

# For a different compatible server, set LLM_PROVIDER=openai_compatible and these.
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_API_KEY=
